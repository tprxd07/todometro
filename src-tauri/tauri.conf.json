{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TODOmetro",
  "version": "1.0.0",
  "identifier": "com.tprxd07.todometro",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TODOmetro",
        "width": 320,
        "height": 430,
        "minWidth": 300,
        "minHeight": 360,
        "resizable": true,
        "maximizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "center": true,
        "visible": true,
        "focus": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Cronometro y contador minimalista con historial",
    "longDescription": "TODOmetro es un cronometro y un contador regresivo en una ventana compacta, con banderas, laps, historial local y atajos de teclado.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
